@model IEnumerable<Kisi>
@{
    ViewData["Title"] = "Tüm Kayıtlar";
}

<div class="text-center  mx-auto">
    @if (!Model.Any())
    {
        <div class="alert alert-info d-flex" role="alert" style="flex-direction:column">
            Rehberde kayıtlı kişi bulunmamaktadır. "Yeni Kayıt" sayfasından kişi ekleyebilirsiniz.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between mb-5">
            <h3>Tüm Kayıtlar</h3>
            <div style="display: flex; align-items: center; width: 250px; border: 1px solid #ccc; border-radius: 4px; padding: 4px;">
                <form id="aramaForm" method="post" action="/Home/Index" style="display: flex; align-items: center; width: 300px; border: 1px solid #ccc; border-radius: 4px; padding: 4px;">
                    <input type="search" name="keyword" id="aramaInput" value="@ViewBag.AramaKelimesi" placeholder="Ara..." style="flex: 1; border: none; outline: none;" />
                </form>
                <a id="btnDataTable" class="btn btn-primary" style="margin-left: 10px;">DataTable</a>


            </div>
        </div>
        <table style="width: 100%" id="tblKisiler" class="display">
            <thead>
                <tr>
                    <th>Adı</th>
                    <th>Soyadı</th>
                    <th>Cep Telefonu</th>
                    <th>İş Telefonu</th>
                    <th>Adres 1</th>
                    <th>Adres 2</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kisi in Model)
                {
                    <tr>
                        <td><a asp-controller="Kisi" asp-action="Index" asp-route-id="@kisi.Id" style="width:15%; min-width:15%;margin-left: 5px;">@kisi.Adi</a></td>
                        <td><a asp-controller="Kisi" asp-action="Index" asp-route-id="@kisi.Id" style="width:15%; min-width:15%; margin-left: 5px;">@kisi.Soyadi</a></td>
                        <td><a asp-controller="Kisi" asp-action="Index" asp-route-id="@kisi.Id" style="width:10%;  min-width:10%;margin-left: 5px;">@kisi.CepTel</a></td>
                        <td><a asp-controller="Kisi" asp-action="Index" asp-route-id="@kisi.Id" style="width:10%; min-width:10%; margin-left: 5px;">@kisi.IsTel</a></td>
                        <td><a asp-controller="Kisi" asp-action="Index" asp-route-id="@kisi.Id" style="width:25%; min-width:25%; margin-left: 5px;">@kisi.Adres1</a></td>
                        <td><a asp-controller="Kisi" asp-action="Index" asp-route-id="@kisi.Id" style="width:25%; min-width:25%; margin-left: 5px;">@kisi.Adres2</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>


<script>
    // $("#aramaInput").on("keydown", function(event){
    //     if(event.key === "Enter"){
    //         event.preventDefault();
    //         const keyword = $("#aramaInput").val();
    //         $.ajax({
    //             url: '/Home/Index',
    //             type: 'POST',
    //             data: { keyword: keyword },
    //             success: function (data) {
    //                 $("#tbody").html("");
    //                 $("#tbody").html(data);
    //                 $('#tblKisiler').DataTable();
    //             },

    //             error: function (err) {
    //                 console.log(err.responseText);
    //             }
    //         });
    //     }
    // })


    $("#btnDataTable").on("click", function () {
        var keyword = $("#aramaInput").val();

         $.ajax({
                url: `/Home/GetAllWithDataTable`,
                type: 'GET',
                dataType: 'json',
                data: { keyword: keyword },
                
                success: function (data) {
                    var table = $("#tblKisiler");
                    var thead = table.find("thead");
                    var tbody = table.find("tbody");

                    thead.empty();
                    tbody.empty();

                    if (data.length === 0) {
                        thead.append("<tr><th>Sonuç bulunamadı</th></tr>");
                        return;
                    }

                    // Başlık satırı
                    var headers = Object.keys(data[0]);
                    var headerRow = "<tr>";
                    headers.forEach(function (key) {
                        headerRow += "<th>" + key + "</th>";
                    });
                    headerRow += "</tr>";
                    thead.append(headerRow);

                    // Veri satırları
                    data.forEach(function (item) {
                        var row = "<tr>";
                        headers.forEach(function (key) {
                            row += "<td>" + (item[key] ?? "") + "</td>";
                        });
                        row += "</tr>";
                        tbody.append(row);
                    });
                },
                error: function () {
                    alert("Hata oluştu. Lütfen tekrar deneyin.");
                }
            });


    });



</script>
